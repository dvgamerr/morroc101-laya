# LAYA — System-1 decision engine (low-level reflex: เลือก action / ตัดสินใจตอบแชท)
LAYA_API_URL=https://nlp.wedolabs.net/laya/v1/systemone
LAYA_API_KEY=
LAYA_MODEL=laya-multilingual

# oMLX — local LLM (planner + chat reply), OpenAI-compatible
# ใช้ https:// หรือ endpoint ที่อยู่ในเครื่อง/VPN เท่านั้น: API key ถูกส่งไปกับทุก request (http ข้ามเครือข่ายไม่เข้ารหัส)
OMLX_BASE_URL=http://127.0.0.1:8000/v1
OMLX_API_KEY=
OMLX_MODEL=Qwen3.8-9B-mlx-4Bit

# Game
GAME_URL=https://morroc101.duckdns.org/play/
# ที่โหลด data/navi_*.txt ของ client (Config.local.js remoteClient + data/)
GAME_DATA_URL=https://morroc101.duckdns.org/client/data/
OWNER_NAME=พี่เขม
# ใช้เฉพาะ `bun run check:browser` (bot ต่อ Chrome ที่เปิดไว้เอง ไม่เปิด browser)
# chrome | msedge | chromium (chromium ต้อง `bunx playwright install chromium` ก่อน)
BROWSER_CHANNEL=chrome
# Chrome ที่ bot เปิดเอง/ต่อด้วย CDP: port นี้เปิดบน 127.0.0.1 เท่านั้น แต่ใครบนเครื่องที่ต่อได้ก็คุม
# เบราว์เซอร์ (และ session ที่ login เกมอยู่ใน .browser-profile) ได้ ห้ามเปิดให้เครือข่ายอื่น/ห้าม forward
CDP_PORT=9333
# path ของ chrome.exe ถ้าไม่ได้ติดตั้งในที่มาตรฐาน (ว่าง = ค้นหาเอง แล้วใช้ Chromium ของ Playwright)
CHROME_PATH=

# Loop tuning
# มี Priest เดินตามฮีล: เน้น EXP และเลือกมอนระดับสูงขึ้น; ตั้ง false เมื่อเล่นคนเดียว
PRIEST_SUPPORT=false
TICK_MS=300
PLANNER_INTERVAL_MS=300000

# Discord webhook: แจ้งเมื่อเปลี่ยนเป้าหมาย (เก็บเลเวล / หาเงิน / ขายของ / ซื้อของ / พัก)
DISCORD_WEBHOOK_URL=

# สายอาชีพ (เปลี่ยนทีละขั้นที่ Job Master) และ build ที่ใช้อัป stat/skill
CLASS_PATH=Merchant,Blacksmith,High Novice,High Merchant,Whitesmith,Mechanic,Meister
BUILD=axe_meister
BUILD_DESCRIPTION=Two-handed Axe Meister: STR main, DEX to hit, VIT to survive, some AGI; axe skills
